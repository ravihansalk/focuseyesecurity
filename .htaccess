# Apache config for SiteGround hosting (Azure uses staticwebapp.config.json instead)

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the non-www domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://focuseyesecurity.co.nz%{REQUEST_URI} [L,R=301]

  # 301 /index.html -> /  and  /page.html -> /page (browser requests only, so no loop)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [L,R=301]

  # Serve /page from page.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  <Files "404.html">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
